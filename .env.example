# Configuration for meet. Copy to .env (meet setup does it for you).
#
# .env is gitignored. Everything here has a working default, so an empty .env is
# fine -- set only what you want to change.
#
# Precedence: real environment > .env > built-in default.
# So `MEET_NOTES=/tmp/scratch meet stop` overrides this file for one run.

# ---------------------------------------------------------------------------
# Where notes are written
# ---------------------------------------------------------------------------

# Directory finished notes are written to, created on demand.
# Defaults inside the project, so nothing is assumed about how you keep notes.
# Point it into an Obsidian vault, or anywhere else you like.
# Default: <project>/notes
# MEET_NOTES=~/Documents/MyVault/Meetings

# ---------------------------------------------------------------------------
# Language
# ---------------------------------------------------------------------------

# The recogniser is pinned to one language rather than detecting per chunk,
# because auto-detection drifts mid-sentence into unrelated languages.
#
#   en    English (default)
#   zh    Mandarin -- also the right choice for MIXED Mandarin/English audio,
#         because Chinese decoding transcribes embedded English correctly while
#         English decoding does not
#   auto  detect per chunk; only for audio that is neither English nor Mandarin
#
# Override for a single run with --language.
# Default: en
# MEET_LANGUAGE=zh

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------

# Speech recogniser. Any Qwen3-ASR conversion on Hugging Face works.
# 1.7B is the accuracy choice; 0.6B is roughly half the memory and faster.
# Default: mlx-community/Qwen3-ASR-1.7B-bf16
# MEET_ASR_MODEL=mlx-community/Qwen3-ASR-0.6B-bf16

# Summarising model, run locally through MLX. Any mlx-lm compatible chat model
# works; larger ones write better notes and take longer.
# Default: mlx-community/Qwen3.5-9B-MLX-4bit
# MEET_SUMMARY_MODEL=mlx-community/Qwen3.5-4B-MLX-4bit

# ---------------------------------------------------------------------------
# Hugging Face
# ---------------------------------------------------------------------------

# Optional. Models are public, so downloads work without a token -- but an
# unauthenticated download prints:
#
#   Warning: You are sending unauthenticated requests to the HF Hub. Please set
#   a HF_TOKEN to enable higher rate limits and faster downloads.
#
# It is a warning, not an error, and it only appears while models are actually
# being fetched. Setting a read token from
# https://huggingface.co/settings/tokens silences it and lifts the anonymous
# rate limit. Anything set here reaches the recogniser, the summariser, and
# `meet setup --prefetch-models`.
# HF_TOKEN=hf_...

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# All of these default to somewhere inside the project directory, so a clone is
# self-contained. Point them elsewhere to keep large files out of the checkout.

# Project root that the paths below hang off.
# Default: the checkout containing this file
# MEET_ROOT=~/.local/share/meet

# Downloaded model files.
# Default: $MEET_ROOT/models
# MEET_MODELS=~/models/meet

# Recordings and their transcripts.
# Default: $MEET_ROOT/recordings
# MEET_RECORDINGS=~/Recordings/meet

# Your vocabulary file. The --glossary flag overrides this per run.
# Default: $MEET_ROOT/glossary.txt
# MEET_GLOSSARY=~/notes/meeting-glossary.txt

# Cloned and built third-party tools (audiotee).
# Default: $MEET_ROOT/vendor
# MEET_VENDOR=~/src/vendor

# ---------------------------------------------------------------------------
# Advanced: individual binaries and model files
# ---------------------------------------------------------------------------

# The audiotee binary that captures system audio.
# Default: $MEET_VENDOR/audiotee/.build/release/audiotee
# MEET_AUDIOTEE=/usr/local/bin/audiotee

# Silero voice-activity-detection model.
# Default: $MEET_MODELS/silero_vad.onnx
# MEET_VAD_MODEL=~/models/silero_vad.onnx

# SenseVoice model directory, only used with --engine sensevoice.
# Default: $MEET_MODELS/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2025-09-09
# MEET_SENSEVOICE_DIR=~/models/sense-voice
